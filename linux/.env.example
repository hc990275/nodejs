# ==============================================================================
# 极速云专线 - 全 Linux 系统综合自适应商业机场环境变量配置 (.env)
# 说明：每项参数均支持留空，系统将智能自愈处理；【必填项】必须手动填写
# ==============================================================================


# +---------------------------------------------------------------------------+
# |  第 1 组：服务器网络基础配置                                               |
# +---------------------------------------------------------------------------+

# 【必填项】机场主服务对外监听主端口
# 翼龙/宝塔面板请填写面板分配的主端口，普通 VPS 可填 8080 或 10809 等任意未占用端口
SERVER_PORT=

# 【选填项】主端口别名（与 SERVER_PORT 等效，系统优先读取 SERVER_PORT，此项留空即可）
PORT=

# 【选填项】宿主机外网公网 IPv4 地址
# 留空时系统将自动通过权威接口探测真实公网 IP，99% 情况下无需手动填写
SERVER_IP=


# +---------------------------------------------------------------------------+
# |  第 2 组：管理员身份认证配置                                               |
# +---------------------------------------------------------------------------+

# 【必填项】管理员后台登录密码与订阅 Token
# 请设置高强度密码（建议 16 位以上随机字符）；留空系统将自动生成随机临时密码（重启后不同）
ADMIN_TOKEN=

# 【选填项】管理员密码兼容别名（与 ADMIN_TOKEN 等效，系统优先读取 ADMIN_TOKEN，此项留空即可）
ADMIN_PASSWORD=


# +---------------------------------------------------------------------------+
# |  第 3 组：Hysteria 2 协议配置（基于 UDP/QUIC 暴力抗丢包）                |
# +---------------------------------------------------------------------------+

# 【选填项】Hysteria 2 协议监听端口（例如填写: 10800）
# 留空或未填写则禁用 Hysteria 2 协议，不占用任何端口
PORT_HY2=

# 【选填项】是否启用 Hysteria 2 协议（填 true 开启，填 false 关闭）
ENABLE_HY2=true

# 【选填项】是否启用 Hysteria 2 专属 UDP 端口跳跃功能
# 端口跳跃可突破运营商 UDP QoS 限速/封锁，填 true 开启，填 false 关闭
ENABLE_HY2_HOP=true

# 【选填项】Hysteria 2 端口跳跃范围（自动配置 iptables 重定向，例如填写: 10900-10909）
# 留空则不启用端口跳跃（即便 ENABLE_HY2_HOP=true）
HY2_HOP_PORTS=

# 【选填项】Hysteria 2 端口跳跃客户端轮换周期（例如填写: 30s）
HY2_HOP_INTERVAL=30s


# +---------------------------------------------------------------------------+
# |  第 4 组：TUIC v5 协议配置（基于 UDP/QUIC 0-RTT 极低延迟）              |
# +---------------------------------------------------------------------------+

# 【选填项】TUIC v5 协议监听端口（例如填写: 10801）
# 留空或未填写则禁用 TUIC v5 协议
PORT_TUIC=

# 【选填项】是否启用 TUIC v5 协议（填 true 开启，填 false 关闭）
ENABLE_TUIC=true


# +---------------------------------------------------------------------------+
# |  第 5 组：VLESS Reality 协议配置（TCP/TLS 偷跑大站证书，0 特征）        |
# +---------------------------------------------------------------------------+

# 【选填项】VLESS Reality 协议监听端口（例如填写: 10802）
# 留空或未填写则禁用 VLESS Reality 协议
PORT_REALITY=

# 【选填项】是否启用 VLESS Reality 协议（填 true 开启，填 false 关闭）
ENABLE_REALITY=true

# 【选填项】VLESS Reality 伪装偷跑目标大站域名
# 用于伪装成主流 HTTPS 流量，建议选择 CDN 较大的站，例如: addons.mozilla.org
REALITY_DEST=addons.mozilla.org

# 【选填项】VLESS Reality 伪装目标大站的 HTTPS 端口（通常保持 443，无需修改）
REALITY_PORT=443


# +---------------------------------------------------------------------------+
# |  第 6 组：TCP 原生直连协议配置（VLESS-TCP / Trojan-TCP）                 |
# +---------------------------------------------------------------------------+

# 【选填项】VLESS TCP 原生纯直连监听端口（无 WebSocket 封装，延迟极低，例如填写: 10803）
# 留空或未填写则禁用
PORT_VLESS_TCP=

# 【选填项】是否启用 VLESS TCP 原生直连协议（填 true 开启，填 false 关闭）
ENABLE_VLESS_TCP=true

# 【选填项】Trojan TCP 原生纯直连监听端口（例如填写: 10804）
# 留空或未填写则禁用
PORT_TROJAN_TCP=

# 【选填项】是否启用 Trojan TCP 原生直连协议（填 true 开启，填 false 关闭）
ENABLE_TROJAN_TCP=true


# +---------------------------------------------------------------------------+
# |  第 7 组：Shadowsocks 2022 (AEAD 多用户专属密钥模式)                      |
# +---------------------------------------------------------------------------+

# 【选填项】Shadowsocks 2022 AEAD 协议监听端口（例如填写: 10805）
# 留空或未填写则禁用
PORT_SS=

# 【选填项】是否启用 Shadowsocks 2022 协议（填 true 开启，填 false 关闭）
ENABLE_SS=true

# 【选填项】Shadowsocks 2022 加密算法（推荐保持默认值，无需修改）
SS_METHOD=2022-blake3-aes-128-gcm


# +---------------------------------------------------------------------------+
# |  第 8 组：256MB 极小 VPS 内存与 CPU 轻量化约束配置                       |
# +---------------------------------------------------------------------------+

# 【推荐配置】限制 Sing-box 运行时的最大物理内存 (防止 Go 内存膨胀导致 OOM)
GOMEMLIMIT=40MiB

# 【推荐配置】Go 垃圾回收激进度 (数值越小回收越积极，推荐 20)
GOGC=20


# +---------------------------------------------------------------------------+
# |  第 9 组：Linux 系统自适应配置                                            |
# +---------------------------------------------------------------------------+

# 【选填项】是否允许系统在检测到缺失依赖时自动调用 Linux 包管理器安装
# 填 true：系统自动安装 sing-box、cloudflared 等缺失工具（推荐开启）
# 填 false：关闭自动安装，需手动预装所有依赖
LINUX_AUTO_INSTALL=true
