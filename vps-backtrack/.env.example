# ====================================================
# VPS 纯原生 Node.js VLESS 端口回溯与微测网优选系统 (vps-backtrack)
# 示例环境变量模板
# ====================================================

# 1. 服务监听端口 (NAT 小鸡本地监听端口，如服务商分配的端口)
PORT=19900
SERVER_PORT=19900

# 2. NAT 宿主机外部映射公网端口 (若直通无映射则与 PORT 相同)
PUBLIC_PORT=19900

# 3. Cloudflare 绑定的 CDN 接入域名 (开启小黄云 Proxy)
SUB_DOMAIN=backtrack.example.com

# 4. Cloudflare Origin Rules 端口回溯配置 (默认为空时自动对齐 PUBLIC_PORT)
BACKTRACK_PORT=19900

# 5. NAT 宿主机公网 IP 或 DDNS 域名 (用于直连节点，不填则自动探测)
SERVER_IP=

# 6. 管理员访问密码
ADMIN_PASSWORD=your_secure_password_here

# 7. 运营初始策略
DEFAULT_ALLOW_REGISTER=true
DEFAULT_DAYS=365
DEFAULT_TRAFFIC_GB=100

# 8. 注册风控频率限制
IP_REGISTER_COOLDOWN_SEC=2
IP_DAILY_REGISTER_LIMIT=5

# 9. 内存自适应调优 (专为 128M / 256M NAT 小鸡优化，避免 OOM)
NODE_OPTIONS=--max-old-space-size=64 --expose-gc
UV_THREADPOOL_SIZE=16
MALLOC_ARENA_MAX=2
