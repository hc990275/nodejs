# ====================================================
# 环境变量模板 (kata-tunnel 开源分享版)
# 复制本文件为 .env 并在本地修改配置
# ====================================================

# 1. 端口配置 (留空由翼龙面板自动注入 SERVER_PORT 或 PORT)
SERVER_PORT=
PORT=

# 2. 管理密码 (登录后台密码，生产环境请务必修改)
ADMIN_PASSWORD=

# 3. 落地公网 IP / 域名 (留空自动感知)
SUB_DOMAIN=

# 4. 运营初始套餐
DEFAULT_ALLOW_REGISTER=false
DEFAULT_DAYS=30
DEFAULT_TRAFFIC_GB=10

# 5. Cloudflare Argo 穿透 (可选)
ARGO_TOKEN=
ARGO_DOMAIN=

# 可选：Wetest API 地址，使用自己获授权的地址（含所需查询参数）
WETEST_API_URL=
IP_REGISTER_COOLDOWN_SEC=60
IP_DAILY_REGISTER_LIMIT=3
SUBAPI=local
ENABLE_ECH=false
