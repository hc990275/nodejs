# ====================================================
# 卡塔纯隧道服务器环境配置文件 (kata-tunnel)
# 适配规格：308MB RAM | 716MB NVMe | 25% CPU | 翼龙面板单端口
# ====================================================

# 1. 服务监听端口 (翼龙面板自动注入 SERVER_PORT 或 PORT)
SERVER_PORT=20255
PORT=20255

# 2. 管理员访问密码 (可在后台直接修改并实时热落盘回写)
ADMIN_PASSWORD=admin123

# 3. 接入公网域名或外网 IP (支持绑定的专属域名或留空跟随公网IP)
SUB_DOMAIN=51.75.118.151

# 4. 运营初始策略
DEFAULT_ALLOW_REGISTER=true
DEFAULT_DAYS=365
DEFAULT_TRAFFIC_GB=100

# 5. Cloudflare Argo 隧道穿透 (可选，填入 Token 即可穿透 443 端口并摆脱随机端口限制)
ARGO_TOKEN=
ARGO_DOMAIN=
