# ====================================================
# 环境变量模板 (kata-tunnel 开源分享版)
# 复制本文件为 .env 并在本地修改配置
# ====================================================

# 1. 端口配置 (留空由翼龙面板自动注入 SERVER_PORT 或 PORT)
SERVER_PORT=
PORT=

# 2. 管理密码 (登录后台密码，生产环境请务必修改)
ADMIN_PASSWORD=your_secure_password_here

# 3. 落地公网 IP / 域名 (留空自动感知)
SUB_DOMAIN=

# 4. 运营初始套餐
DEFAULT_ALLOW_REGISTER=true
DEFAULT_DAYS=365
DEFAULT_TRAFFIC_GB=102400

# 5. Cloudflare Argo 穿透 (可选)
ARGO_TOKEN=
ARGO_DOMAIN=
