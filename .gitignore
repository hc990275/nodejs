# =========================================================================
# Git Ignore 规则 (最高安全级别凭据隔离，彻底杜绝泄露)
# =========================================================================

# 1. 环境变量与凭据文件 (强制使用 .env.example 作为脱敏模板)
.env
.env.local
.env.*.local
**/.env
**/.env.*
!**/.env.example

# 2. 运行时动态数据、用户库与节点凭据
data/*
!data/.gitkeep
**/data/*
!**/data/.gitkeep
users.json
settings.json
nodes.json
groups.json
tg_users.json
**/users.json
**/settings.json
**/nodes.json
**/groups.json
**/tg_users.json
**/v3_settings.json
**/v3_settings.json.bak

# 3. 真实服务配置文件与密钥 (防止公网端口密码外泄)
config.json
**/config.json
!**/config.example.json

# 4. 二进制可执行程序与内核
cloudflared
cloudflared.exe
cloudflared-*
**/cloudflared*
sing-box
sing-box.exe
sing-box-*
**/sing-box*

# 5. Node.js 运行时依赖与缓存
node_modules/
**/node_modules/
.npm/
**/.npm/
.npm-global/
**/.npm-global/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 6. 临时文件与进程 PID
.tmp/
**/.tmp/
*.tmp
*.tmp.*
**/*.tmp
**/*.tmp.*
*.pid
**/*.pid

# 7. 日志文件
*.log
logs/
**/logs/

# 8. 证书密钥、TLS 私钥与 Reality 密钥
*.pem
*.key
*.crt
reality_keys.json
**/reality_keys.json
ss_secret.key
**/ss_secret.key
certs/
**/certs/

# 9. 系统与编辑器产生的文件
.DS_Store
Thumbs.db
*.bak
*.bak.*
**/*.bak
**/*.bak.*
*.orig
scratch_*

# 10. 自用隐私文档与同步脚本
*PRIVATE*.md
*private*.md
*_private.*
*自用*.md
TG_BOT_GUIDE_PRIVATE.md
**/TG_BOT_GUIDE_PRIVATE.md
sync.ps1
sync.bat
sync.sh
.git_sync_cache/
