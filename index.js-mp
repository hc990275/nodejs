/**
 * 翼龙面板专用：MTProto 代理启动管理器 (基于 mtg 核心引擎)
 * 优化特性：
 * 1. 采用高强度加密级随机源生成 Fake-TLS Secret
 * 2. 完善外部命令环境检测与异常处理
 * 3. 增强对 IPv4 / IPv6 混合环境及 DNS 故障的容错
 */

const { execSync, spawn } = require('child_process');
const fs = require('fs');
const crypto = require('crypto');
const http = require('http');

// ================= 全局配置区 =================
// 监听端口，优先从环境变量读取
const PORT = process.env.SERVER_PORT || 1080;

// 伪装域名（用于 Fake-TLS SNI 混淆）
const TLS_DOMAIN = process.env.TLS_DOMAIN || "bing.com";

// mtg 核心引擎版本与文件名
const MTG_VER = "2.1.1";
const CORE_PATH = "./mtg_core";
const CONFIG_PATH = "./mtg.toml";
// ============================================

/**
 * 生成符合 Telegram 规范的标准 Fake-TLS 密匙
 * 格式说明: ee + 16字节高强度随机十六进制 + 伪装域名的十六进制字符串
 */
function generateFakeTlsSecret(domain) {
    // 采用 CSPRNG 加密级随机数生成 16 字节 (32 字符十六进制)
    const randomHex = crypto.randomBytes(16).toString('hex');
    const domainHex = Buffer.from(domain, 'utf8').toString('hex');
    return "ee" + randomHex + domainHex;
}

const SECRET = generateFakeTlsSecret(TLS_DOMAIN);

// 自动检测系统 CPU 架构
const systemArch = process.arch === 'arm64' ? 'arm64' : 'amd64';
const downloadUrl = `https://github.com/9seconds/mtg/releases/download/v${MTG_VER}/mtg-${MTG_VER}-linux-${systemArch}.tar.gz`;
const folderName = `mtg-${MTG_VER}-linux-${systemArch}`;

console.log("----------------------------------------------------");
console.log("正在执行运行环境预检...");

// 检查并下载二进制核心程序
if (!fs.existsSync(CORE_PATH)) {
    console.log(`📦 正在下载 mtg v${MTG_VER} (${systemArch}) 二进制核心...`);
    try {
        // 使用静默且显示错误的模式进行下载与解压
        execSync(`wget -qO mtg.tar.gz "${downloadUrl}"`);
        execSync(`tar -xzf mtg.tar.gz`);
        execSync(`mv "${folderName}/mtg" "${CORE_PATH}"`);
        execSync(`chmod +x "${CORE_PATH}"`);
        execSync(`rm -rf mtg.tar.gz "${folderName}"`);
        console.log("✅ 二进制引擎下载并部署成功！");
    } catch (err) {
        console.error("❌ 核心下载或解压失败，请检查网络连接及系统是否安装 wget/tar：", err.message);
        process.exit(1);
    }
} else {
    console.log("✅ 核心引擎已存在，跳过下载阶段。");
}

// 写入运行时配置文件
const tomlContent = `
secret = "${SECRET}"
bind-to = "0.0.0.0:${PORT}"
`;
fs.writeFileSync(CONFIG_PATH, tomlContent.trim());

/**
 * 打印美化后的连接信息面板
 */
function displayPanel(ip, port, secret, domain) {
    const tgLink = `https://t.me/proxy?server=${ip}&port=${port}&secret=${secret}`;
    console.log("\n\x1b[32m====================================================\x1b[0m");
    console.log("\x1b[36m🛡️  MTProto 代理引擎运行中\x1b[0m");
    console.log("\x1b[33m🔗 客户端直连配置链接:\x1b[0m");
    console.log("\x1b[1m\x1b[34m" + tgLink + "\x1b[0m");
    console.log("\x1b[32m----------------------------------------------------\x1b[0m");
    console.log(`📍 公网出口 IP: ${ip}`);
    console.log(`🔢 服务绑定端口: ${port}`);
    console.log(`🔑 混淆 Secret: ${secret}`);
    console.log(`🌐 伪装目标 SNI: ${domain}`);
    console.log("\x1b[32m====================================================\x1b[0m\n");
}

/**
 * 启动代理子进程
 */
function startProxyEngine() {
    console.log("🚀 正在拉起 MTProto 底层传输进程...");
    
    // 注入 GODEBUG=netdns=cgo，确保在容器中优先使用 libc DNS 解析器
    const child = spawn(CORE_PATH, ['run', CONFIG_PATH], {
        stdio: 'inherit',
        env: {
            ...process.env,
            GODEBUG: 'netdns=cgo'
        }
    });

    child.on('error', (err) => {
        console.error("❌ 启动子进程失败:", err.message);
    });

    child.on('close', (code) => {
        console.log(`\x1b[31m[警告] 核心代理进程已退出，退出码: ${code}\x1b[0m`);
    });
}

// 获取出口 IP 并启动服务
const req = http.get('http://api.ipify.org', { timeout: 5000 }, (res) => {
    let rawData = '';
    res.on('data', (chunk) => {
        rawData += chunk;
    });
    res.on('end', () => {
        const publicIp = rawData.trim();
        displayPanel(publicIp, PORT, SECRET, TLS_DOMAIN);
        startProxyEngine();
    });
});

req.on('error', (err) => {
    console.warn(`⚠️ 无法获取外网 IP (${err.message})，将使用通配地址启动面板。`);
    displayPanel("你的服务器外网IP", PORT, SECRET, TLS_DOMAIN);
    startProxyEngine();
});

req.on('timeout', () => {
    req.destroy();
    console.warn("⚠️ 获取外网 IP 超时，以离线模式启动。");
    displayPanel("你的服务器外网IP", PORT, SECRET, TLS_DOMAIN);
    startProxyEngine();
});
