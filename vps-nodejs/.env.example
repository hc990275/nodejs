# ====================================================
# VPS 纯原生 Node.js VLESS 隧道与微测网优选系统 (vps-tunnel)
# 示例环境变量模板
# ====================================================

# 1. 基础服务监听端口 (HTTP / WebSocket 端口)
PORT=80
SERVER_PORT=80

# 2. 原生 TLS/HTTPS 监听端口与证书路径 (可选)
TLS_PORT=443
CERT_PATH=
KEY_PATH=

# 3. 管理员访问密码
ADMIN_PASSWORD=your_secure_password_here

# 4. 接入公网域名或外网 IP
SUB_DOMAIN=vps.example.com

# 5. 运营初始策略
DEFAULT_ALLOW_REGISTER=true
DEFAULT_DAYS=365
DEFAULT_TRAFFIC_GB=100

# 6. Cloudflare Argo 隧道穿透 (可选)
ARGO_TOKEN=
ARGO_DOMAIN=

# 7. 注册风控频率限制
IP_REGISTER_COOLDOWN_SEC=2
IP_DAILY_REGISTER_LIMIT=5

# 8. 内存与并发自适应调优 (部署时自动根据系统内存计算，支持手动热重载覆盖)
NODE_OPTIONS=--max-old-space-size=96 --expose-gc
UV_THREADPOOL_SIZE=16
MALLOC_ARENA_MAX=2
GOMEMLIMIT=40MiB
GOGC=50

