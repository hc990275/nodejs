# ====================================================
# Altare 纯隧道服务器环境配置文件 (altare-tunnel)
# 适配规格：512MB RAM | 716MB NVMe | 25% CPU | 翼龙面板单端口
# ====================================================

# 1. 服务监听端口（翼龙面板自动注入 SERVER_PORT / PORT）
#    留空时服务挂起等待端口配置，不监听假端口。手动部署可填，如 20255
SERVER_PORT=
PORT=

# 2. 管理员访问密码
#    留空 = 部署后首次打开后台强制设置密码（不设置不让进），设置后自动回写本文件
#    也可在部署前直接填入强密码（10–256 位），则跳过首次设置向导
ADMIN_PASSWORD=

# 3. 接入公网域名 / IP（SUB_DOMAIN）
#    留空 = 自动使用隧道域名(ARGO_DOMAIN)，无隧道则自动探测公网 IPv4
#    手动指定时可填专属域名或公网 IP
SUB_DOMAIN=

# 4. 公网 IPv4（订阅 host 回退）
#    留空 = 启动时自动探测公网 IPv4（api.ipify / icanhazip / ifconfig.me）
SERVER_IP=

# 5. 运营初始策略（注册策略）
DEFAULT_ALLOW_REGISTER=true
DEFAULT_DAYS=365
DEFAULT_TRAFFIC_GB=102400
IP_REGISTER_COOLDOWN_SEC=9999999
IP_DAILY_REGISTER_LIMIT=1

# 6. Cloudflare Argo 隧道穿透（可选，填 Token 走 443 摆脱随机端口）
ARGO_TOKEN=
ARGO_DOMAIN=

# 7. ECH / TLS 强安全混淆
ENABLE_ECH=true
ECH_SNI=cloudflare-ech.com
ECH_DNS=https://dns.alidns.com/dns-query
CLIENT_FINGERPRINT=chrome

# 8. 订阅转换与分流规则
SUBAPI=local
SUBCONFIG=https://raw.githubusercontent.com/ACL4SSR/ACL4SSR/master/Clash/config/ACL4SSR_Online.ini

# 9. 微测网三网优选 API（CF 优选 IP）
WETEST_API_URL=https://www.wetest.vip/api/cf2dns/get_cloudflare_ip?key=o1zrmHAF&type=v4
