# ==============================================================================
# V3 节点网关环境变量配置文件模板 (.env.example)
# 请复制为 .env 并根据新服务器实际情况配置
# ==============================================================================

# ----------------- 1. 安全与管理后台口令 (必填) -----------------
# 管理后台登录凭据 (访问 /admin 或 /admin?token=xxx)
ADMIN_TOKEN=your_secure_password_here

# ----------------- 2. 网络监听与公网地址自适应 -----------------
# 主监听端口 (普通 VPS 推荐 8080 或 21216；NAT 鸡/翼龙面板填写分配的公网转发端口)
SERVER_PORT=8080

# 服务器公网 IPv4 (留空则系统启动时自动探测公网 IP)
SERVER_IP=

# 自定义对外域名 (Cloudflare 端口回溯 / CDN 优选主域名，如: yylsl.abcai.online)
# 配置端口回溯后，客户端可通过标准 443 端口连接
SERVER_DOMAIN=

# ----------------- 3. Cloudflare Argo 隧道与 CDN 优选 (选填) -----------------
ARGO_TOKEN=
ARGO_DOMAIN=
OPTIMIZED_DOMAIN=

# ----------------- 4. 多节点集群与异地节点扩展 (选填) -----------------
EXTRA_NODES=

# ----------------- 5. 极速协议参数配置 (Hy2 / TUIC / Reality) -----------------
UDP_QUIC_PROTOCOL=hy2
TUIC_PORT=
REALITY_DEST=www.apple.com:443
REALITY_SNI=www.apple.com

