# ==============================================================================
# 卡塔服务器 (翼龙容器) 节点网关环境变量配置文件模板 (.env.example)
# 复制本文件重命名为 .env，并根据实际情况修改配置
# 提示：本系统具备原生毫秒级热重载引擎，修改并保存 .env 后立即生效，无需重启容器！
# ==============================================================================

# ----------------- 1. 安全与管理后台口令 (必填，严禁空置) -----------------
# 后台登录管理安全口令（原 ADMIN_TOKEN）。系统执行 Fail-Closed 熔断保护：未配置时后台自动锁定
ADMIN_TOKEN=123456

# ----------------- 2. 网络监听与公网地址自适应 (选填) -----------------
# 容器外网服务监听端口。卡塔/翼龙容器通常会自动通过环境变量注入分配的物理端口 (SERVER_PORT / PORT)
# 在翼龙容器中此处可直接留空由系统自动提取；若处于本地或其他环境，必须在此显式指定实际端口，杜绝 8000 假端口兜底！
SERVER_PORT=

# 宿主机公网 IP (选填，留空时系统自动探测公网 IP，换机器无需修改！)
SERVER_IP=

# 自定义对外域名 (选填，适用于 Cloudflare 端口回溯 / CDN 反向代理 / 自定义域名)
# 例如: shop.995677.xyz。配置后系统生成的订阅地址和 CDN 代理节点将优先使用该域名！
SERVER_DOMAIN=

# ----------------- 3. Cloudflare Argo 隧道与 CDN 优选 (选填) -----------------
# Cloudflare Argo 临时或命名隧道 Token，留空则仅启用 IP 端口直连
ARGO_TOKEN=

# Argo 隧道绑定的主域名，例如: tunnel.yourdomain.com
ARGO_DOMAIN=

# CDN 优选域名或优选 IP，例如: cdn.cloudflare.com 或 104.16.0.1
OPTIMIZED_DOMAIN=

# ----------------- 4. 多节点集群与异地节点扩展 (选填) -----------------
# 支持以 JSON 数组字符串形式注入异地或额外节点配置
EXTRA_NODES=

# ----------------- 5. 极速协议参数配置 (Hy2 / TUIC / Reality) -----------------
# 翼龙单端口铁律：卡塔容器仅分配一个端口！
# TCP 方向：HTTP 后台、API、VLESS-WS、VMess-WS、Trojan-WS、VLESS-Reality 全部共用此端口。
# UDP 方向：单端口下同一时间由一种 QUIC 协议独占该端口。
# 选填: hy2 (默认，单端口下跨洲加速最优) 或 tuic (轻量平滑，极低内存占用)
# 智能多端口：若翼龙面板分配了多个 Allocations (SERVER_PORT_2 等)，系统将全自动感知并同时双开 Hy2 + TUIC！
UDP_QUIC_PROTOCOL=hy2

# 若处于普通多端口 VPS 环境，可显式指定独立的 TUIC UDP 端口；若在翼龙多端口容器下则无需填写（全自动探测）
TUIC_PORT=

# VLESS-Reality 伪装目标服务与端口 (默认 www.apple.com:443，同端口 TCP 0x16 探测共存)
REALITY_DEST=www.apple.com:443

# VLESS-Reality 客户端 ServerName (SNI，默认 www.apple.com)
REALITY_SNI=www.apple.com


